# ===== Transense Backend Configuration =====
# Copy this file to `.env.local` and fill in the values.
# `TRANSENSE_ENVIRONMENT` and `TRANSENSE_ALLOWED_ORIGINS` are REQUIRED.
# Everything else has sane defaults for local development.

# Required: runtime environment. Use `local` for development.
TRANSENSE_ENVIRONMENT=local

# Required: comma-separated exact origins allowed by CORS + WebSocket.
TRANSENSE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# SQLite database file (auto-created). Leave default unless you know why.
TRANSENSE_DATABASE_PATH=backend/transense.sqlite3

# ---- TransJakarta GTFS (static: stops, routes, shapes, schedules) ----
# Official feed is downloaded and cached automatically on first startup.
TRANSENSE_GTFS_URL=https://gtfs.transjakarta.co.id/files/file_gtfs.zip
TRANSENSE_GTFS_CACHE_PATH=backend/gtfs_cache.zip

# ---- TransJakarta Realtime (live bus positions) ----
# Set to 1 to enable live bus tracking from the internal TJ API.
# If disabled, the map still shows GTFS stops/routes but no live buses.
TRANSENSE_REALTIME_ENABLED=1
TRANSENSE_REALTIME_API_BASE=https://tijeapi.transjakarta.co.id
TRANSENSE_REALTIME_RADIUS_KM=5.0
TRANSENSE_REALTIME_CENTER_LAT=-6.1944
TRANSENSE_REALTIME_CENTER_LNG=106.8227

# ---- Transcription (ElevenLabs) ----
# Required only if you want live speech-to-text transcription.
# Get a key at https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
