# ===== Transense — single env file (root) =====
# Copy this file to `.env` and fill in your values.

# --- Backend (FastAPI) ---
TRANSENSE_ENVIRONMENT=local
TRANSENSE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set to 1 to enable live bus tracking from TransJakarta internal API
TRANSENSE_REALTIME_ENABLED=1
# Get your key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_elevenlabs_key

# --- Database ---
# Leave unset to use SQLite (backend/transense.sqlite3). Set a Postgres DSN to
# use PostgreSQL instead (e.g. via Docker: postgresql://transense:transense@db:5432/transense)
# DATABASE_URL=postgresql://transense:transense@localhost:5432/transense

# --- Services (routing / realtime / geocoding) ---
# Future wiring untuk integrasi Redis, OpenTripPlanner, dan Photon:
# REDIS_URL=redis://localhost:6379/0
# OTP_URL=http://localhost:8080/otp/routers/default
# PHOTON_URL=http://localhost:2322

# --- Frontend (Vite / PWA) ---
VITE_API_BASE_URL=http://localhost:8000
# Get your public token at https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
