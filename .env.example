# ===== Transense — single env file (root) =====
# Copy this file to `.env` and fill in your values.

# --- Backend (FastAPI) ---
TRANSENSE_ENVIRONMENT=local
TRANSENSE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set to 1 to enable live bus tracking from TransJakarta internal API
TRANSENSE_REALTIME_ENABLED=1
# Get your key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_your_elevenlabs_key

# --- Frontend (Vite / PWA) ---
VITE_API_BASE_URL=http://localhost:8000
# Get your public token at https://account.mapbox.com
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here
